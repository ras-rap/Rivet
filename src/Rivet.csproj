<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Rivet</RootNamespace>
    <AssemblyName>Rivet</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="aelsi2.Facepunch.Steamworks" Version="2.3.4" />
  </ItemGroup>
  <Target Name="CopySteamLib" AfterTargets="Build">
    <Copy SourceFiles="$(NuGetPackageRoot)facepunch.steamworks.win64\2.5.2\runtimes\linux-x64\native\libsteam_api.so" DestinationFiles="$(OutDir)libsteam_api64.so" Condition="Exists('$(NuGetPackageRoot)facepunch.steamworks.win64\2.5.2\runtimes\linux-x64\native\libsteam_api.so')" SkipUnchangedFiles="true" />
  </Target>
</Project>

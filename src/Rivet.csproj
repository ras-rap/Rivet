<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Rivet</RootNamespace>
    <AssemblyName>Rivet</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Facepunch.Steamworks" Version="2.3.3" />
  </ItemGroup>
  <Target Name="CopySteamDll" AfterTargets="Build">
    <Copy SourceFiles="$(NuGetPackageRoot)facepunch.steamworks\2.3.3\content\steam_api64.dll"
          DestinationFolder="$(OutDir)"
          Condition="Exists('$(NuGetPackageRoot)facepunch.steamworks\2.3.3\content\steam_api64.dll')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
